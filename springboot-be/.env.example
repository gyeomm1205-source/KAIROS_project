APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,https://kairos.cloud-ip.cc,http://kairos.cloud-ip.cc
APP_FASTAPI_BASE_URL=http://localhost:8000
APP_SECURITY_COGNITO_ENABLED=false
APP_SECURITY_COGNITO_REGION=ap-northeast-2
APP_SECURITY_COGNITO_USER_POOL_ID=ap-northeast-2_example
APP_SECURITY_COGNITO_CLIENT_ID=your-cognito-app-client-id
APP_SECURITY_COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_example
APP_SECURITY_COGNITO_TOKEN_USE=access
APP_SECURITY_COGNITO_USERNAME_CLAIM=cognito:username
DB_URL=jdbc:h2:mem:app;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DATABASE_TO_UPPER=false
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
JPA_DDL_AUTO=update
